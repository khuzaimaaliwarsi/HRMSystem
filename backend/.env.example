# ==============================================================================
# iSysware HRMS — Backend Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure with your local environment values:
#   cp .env.example .env
#
# DO NOT commit the .env file containing real passwords or secrets to Git.
# ==============================================================================

# Server Network & Runtime Configuration
PORT=5000
NODE_ENV=development
API_VERSION=v1

# CORS Allowed Origins (Comma-separated for multiple origins, e.g. local Vite frontend)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# PostgreSQL Connection String (Prisma format)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
# Default local PostgreSQL 18 configuration:
# - User: postgres (or your custom pg user)
# - Host: localhost
# - Port: 5432
# - Database: aliyan_hrms_dev
# - Schema: public
DATABASE_URL="postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/aliyan_hrms_dev?schema=public"

# Database Connection Pool Settings
DATABASE_TIMEOUT_MS=5000

# Security & Future Authentication (Batch 2/3 Preparation)
JWT_SECRET=replace_with_strong_random_secret_in_auth_batch
JWT_EXPIRES_IN=8h

